<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".FeriferiApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Feriferi">

        <activity
            android:name=".view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.DashboardActivity"
            android:exported="true" />

        <activity
            android:name=".view.AddToCartActivity"
            android:exported="true" />

        <activity
            android:name=".view.LoginActivity"
            android:exported="true" />

        <activity
            android:name=".view.RegistrationActivity"
            android:exported="true" />

        <activity
            android:name=".view.AddProductActivity"
            android:exported="true" />

        <activity
            android:name=".view.CategoryActivity"
            android:exported="false" />

        <activity
            android:name=".view.ItemDescriptionActivity"
            android:exported="false" />

        <activity
            android:name=".view.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".view.SettingsActivity"
            android:exported="true" />

        <activity
            android:name=".view.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".view.SellerPageActivity"
            android:exported="false" />

        <activity
            android:name=".view.SellerDashboardActivity"
            android:exported="true" />

        <activity
            android:name=".view.FavouriteActivity"
            android:exported="false" />

        <activity
            android:name=".view.NotificationActivity"
            android:exported="false" />

        <activity
            android:name=".view.ChatFairyActivity"
            android:exported="true" />

    </application>

</manifest>