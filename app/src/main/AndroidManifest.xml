<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.Feriferi">

        <activity
            android:name=".view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".view.LoginActivity"
            android:exported="true" />
        <activity android:name=".view.RegistrationActivity"
            android:exported="true" />
        <activity android:name=".view.DashboardActivity"
            android:exported="true" />
        <activity android:name=".view.SellerDashboardActivity"
            android:exported="true" />
        <activity android:name=".view.AdminDashboardActivity"
            android:exported="true" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="true" />

    </application>
</manifest>