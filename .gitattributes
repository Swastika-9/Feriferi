# Set default behavior to automatically normalize line endings
* text=auto

# Kotlin, Java, XML, Gradle files should always use LF
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.pro text eol=lf

# Image files and binaries should be treated as binary
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.xml binary
